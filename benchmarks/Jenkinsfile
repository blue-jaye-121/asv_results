pipeline {
	agent  { label 'main' }
	environment {
		CLONE_DIR = "temp_repo_results"
	}
	stages {
		stage('Checkout results repo') {
			steps {
				checkout scmGit(branches: [[name: '*/main']], extensions: [[$class: 'RelativeTargetDirectory', relativeTargetDir: 'temp_repo_results'], cloneOption(depth: 1, noTags: false, reference: '', shallow: true)], userRemoteConfigs: [[url: 'https://github.com/blue-jaye-121/results_asv_results.git']])
			}
		}
		stage('Copy past results') {
			steps {
				sh '''
    				cp -r ${CLONE_DIR}/results benchmarks/asv/results
				'''
			}
		}
		stage('Run ASV') {
			steps {
				sh '''
				cd benchmarks 
				docker build -t metpy-benchmarks:latest .
				cd ..
				docker run --rm -v .:/container-benchmarks --hostname Docker_Container -e DUID=$(id -u) -e DGID=$(id -g) metpy-benchmarks:latest benchmark
				'''
   			}
		}
	}
	post {
		always {
			echo "---Cleaning up temporary repo---"
			sh 'rm -rf "${CLONE_DIR}"'
		}
	}
}
