pipeline {
	agent  { label 'main' }
	environment {
		CLONE_DIR = "temp_repo_results"
	}
	stages {
		stage('Checkout results repo') {
			steps {
				sh 'git config --global credential.helper cache'
				sh 'git config --global push.default simple'
			  	sh 'git config --global user.email "jenkinsbot@noreply.com"'
				sh 'git config --global user.name "JenkinsBot"'
				checkout scmGit(branches: [[name: '*/main']], extensions: [[$class: 'RelativeTargetDirectory', relativeTargetDir: 'temp_repo_results'], cloneOption(depth: 1, noTags: false, reference: '', shallow: true)], userRemoteConfigs: [[credentialsId: 'ASV_RESULTS_REPO_PAT', url: 'https://github.com/blue-jaye-121/results_asv_results.git']])
			}
		}
		stage('Copy past results') {
			steps {
				sh '''
    				if [ -d ${CLONE_DIR}/results ]; then 
					echo "-------Copying results--------"
    					cp -r ${CLONE_DIR}/results/* benchmarks/asv/results
    				fi
				'''
			}
		}
        stage('Setup for ASV run') {
            steps {
                sh '''
                    cd benchmarks
                    generate_hashes.sh
                '''
            }
        }
		stage('Run ASV') {
			steps {
                catchError(buildResult: 'SUCCESS') {
                    sh '''
                    docker build -t metpy-benchmarks:latest .
                    cd ..
                    docker run --rm -v .:/container-benchmarks --hostname Docker_Container -e DUID=$(id -u) -e DGID=$(id -g) metpy-benchmarks:latest benchmark
                    '''
                }
   			}
		}
		stage('Copy results') {
			steps{
				sh '''
    				if [ -d "${CLONE_DIR}/results" ]; then 
					echo "--------results repo exist-------"
				else 
    					mkdir ${CLONE_DIR}/results
	 			fi
    				cp -r benchmarks/asv/results/* ${CLONE_DIR}/results
				'''
			}
		}
		stage('Update results repo') {
			steps {
				withCredentials([gitUsernamePassword(credentialsId: 'ASV_RESULTS_REPO_PAT', gitToolName: 'Default')]) {
					sh '''
				   	if [ -n "$(git status --porcelain)" ]; then 
						cd ${CLONE_DIR} 
						git add --all
						git commit -m "Jenkins Updating Benchmark Results BUILD-NUMBER:${BUILD_NUMBER}"
						git push origin HEAD:main
					fi
					'''
				}
			}
		}
	}
	post {
		always {
			echo "---Cleaning up temporary repo---"
			sh 'rm -rf "${CLONE_DIR}"'
		}
	}
}
